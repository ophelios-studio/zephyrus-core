{
  "name": "zephyrus-framework/core",
  "description": "Cohesive PHP 8.4+ framework — attribute routing, immutable HTTP, typed config, and security middleware out of the box.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-intl": "*",
    "ext-sodium": "*",
    "symfony/yaml": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "latte/latte": "^3.0",
    "tracy/tracy": "^2.10",
    "phpmailer/phpmailer": "^6.9",
    "maskulabs/inertia-psr": "^3.0"
  },
  "suggest": {
    "ext-apcu": "For locale catalog caching via CachedLocaleLoader"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Zephyrus\\": "src/Zephyrus/"
    },
    "files": [
      "src/Zephyrus/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Zephyrus\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
