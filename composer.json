{
  "name": "dadajuice/zephyrus2",
  "description": "Cohesive PHP 8.4+ framework core",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "symfony/yaml": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Zephyrus\\": "src/Zephyrus/"
    },
    "files": [
      "src/Zephyrus/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Zephyrus\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
