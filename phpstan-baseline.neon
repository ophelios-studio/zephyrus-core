# Baseline for the level 6 gate. Hand-grouped, not generated: each group states
# why its findings are deferred rather than fixed.
# Entries match on identifier, path and count, not line number. A count that stops
# matching fails the run on purpose: re-examine it, do not bump it.

parameters:
    ignoreErrors:

        # 1. Readonly properties assigned in fromArray(), not the constructor: fixing it reshapes every config section, so it is deferred as a unit.
        -
            identifier: property.uninitializedReadonly
            path: src/Zephyrus/Mailer/MailerConfig.php
            count: 7
        -
            identifier: property.readOnlyAssignNotInConstructor
            path: src/Zephyrus/Mailer/MailerConfig.php
            count: 7
        -
            identifier: property.uninitializedReadonly
            path: src/Zephyrus/Rendering/RenderConfig.php
            count: 5
        -
            identifier: property.readOnlyAssignNotInConstructor
            path: src/Zephyrus/Rendering/RenderConfig.php
            count: 5

        # 2. Guards that the declared types make unreachable.
        #    DO NOT FIX BY DELETING THE GUARD: callers can pass any value across the boundary,
        #    and several sit in front of a security decision.
        -
            identifier: function.alreadyNarrowedType
            path: src/Zephyrus/Core/Bootstrap/ApplicationBootstrap.php
            count: 3
        -
            identifier: function.alreadyNarrowedType
            path: src/Zephyrus/Core/Config/Configuration.php
            count: 1
        -
            identifier: function.alreadyNarrowedType
            path: src/Zephyrus/Security/ContentSecurityPolicy.php
            count: 1
        -
            identifier: function.alreadyNarrowedType
            path: src/Zephyrus/Upload/FileUpload.php
            count: 1
        -
            identifier: instanceof.alwaysTrue
            path: src/Zephyrus/Http/Request.php
            count: 1
        # new ReflectionClass() throws on an unloadable class-string: the catch is live at runtime.
        -
            identifier: catch.neverThrown
            path: src/Zephyrus/Routing/RouteAttributeReader.php
            count: 1

        # 3. Analyser limitations: the code is correct, PHPStan is not.
        # stdClass public properties are valid to iterate, but PHPStan only accepts declared iterables.
        -
            identifier: foreach.nonIterable
            path: src/Zephyrus/Data/Entity.php
            count: 1
        # Published for consumer controllers; tests/ exercises it, and this config does not analyse tests/.
        -
            identifier: trait.unused
            path: src/Zephyrus/Rendering/RenderResponses.php
            count: 1

        # 4. Redundant normalisation kept on purpose: a cheap guard if a caller ignores a docblock or a preg_* call fails.
        -
            identifier: arrayValues.list
            path: src/Zephyrus/Core/Config/EnvironmentContract.php
            count: 1
        -
            identifier: arrayValues.list
            path: src/Zephyrus/Security/ContentSecurityPolicy.php
            count: 1
        -
            identifier: arrayValues.list
            path: src/Zephyrus/Security/ContentSecurityPolicyMiddleware.php
            count: 1
        -
            identifier: nullCoalesce.offset
            path: src/Zephyrus/Core/Bootstrap/ApplicationBootstrap.php
            count: 1
        -
            identifier: nullCoalesce.offset
            path: src/Zephyrus/Http/Request.php
            count: 2
        -
            identifier: nullCoalesce.offset
            path: src/Zephyrus/Routing/RouteCollection.php
            count: 1
        -
            identifier: nullCoalesce.offset
            path: src/Zephyrus/Routing/RouteUrlGenerator.php
            count: 1
        -
            identifier: nullsafe.neverNull
            path: src/Zephyrus/Core/ApplicationBuilder.php
            count: 3

        # 5. Signatures that answer to something other than PHPStan.
        # SessionHandlerInterface::gc() is declared int|false; narrowing it to int changes a public signature.
        -
            identifier: return.unusedType
            path: src/Zephyrus/Session/DatabaseSessionHandler.php
            count: 1
        # Entity::build() calls new static(): subclasses keep a no-argument constructor.
        # Declaring @phpstan-consistent-constructor would fail analysis in consumers.
        -
            identifier: new.static
            path: src/Zephyrus/Data/Entity.php
            count: 1
        # ConfigSection::fromArray() calls new static(): section subclasses keep the base constructor signature.
        -
            identifier: new.static
            path: src/Zephyrus/Core/Config/ConfigSection.php
            count: 1

        # 6. Missing iterable docblocks, deferred: one-line @param additions. Add them and delete this group.
        -
            identifier: missingType.iterableValue
            path: src/Zephyrus/Core/Bootstrap/ApplicationBootstrap.php
            count: 2
        -
            identifier: missingType.iterableValue
            path: src/Zephyrus/Core/Config/ConfigSection.php
            count: 1
        -
            identifier: missingType.iterableValue
            path: src/Zephyrus/functions.php
            count: 1
