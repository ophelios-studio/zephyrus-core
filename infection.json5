                "Zephyrus\\Session\\DatabaseSessionHandler::forceStrictMode::229", // strict mode is already on
                "Zephyrus\\Session\\SessionCsrfTokenManager::isTokenValid::61", // storedToken() turns empty into null
                "Zephyrus\\Session\\SessionManager::destroy::257", // session id is empty after destroy
                "Zephyrus\\Upload\\FileUpload::listFromPhpArray::26", // flatten rebuilds the same single entry
                "Zephyrus\\Upload\\Uploader::ensureDirectory::526", // mkdir on an existing directory fails silently
                "Zephyrus\\Validation\\Rules::base64Url::852", // strict decode and re-encode refuse the same
                "Zephyrus\\Validation\\Rules::jsonPointer::1440", // regex already requires a leading slash
                "Zephyrus\\Validation\\Rules::rfc3339DateTime::382", // round-trip refuses what the regex refuses
