# Static analysis gate for zephyrus-framework/core.
#
# Level 8 keeps the framework analysed at least as strictly as the applications
# built on it.
#
# Only src/ is analysed. At this level tests/ produces almost only harness noise
# (assertion narrowing, untyped helper arrays, undefined variables in bare view
# fixtures), which would bury the src/ signal.
#
# The baseline is grouped and commented. Read it before adding to it: several
# entries guard code that MUST NOT be "fixed" by deleting it.
includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src

    # Serial on purpose: PHPStan's parallel workers can crash on output write in
    # sandboxed environments, and a crashed worker looks like a passing run. To
    # opt back in locally, drop an untracked phpstan.neon next to this file:
    #
    #   includes:
    #       - phpstan.neon.dist
    #   parameters:
    #       parallel:
    #           maximumNumberOfProcesses: 4
    parallel:
        maximumNumberOfProcesses: 1
